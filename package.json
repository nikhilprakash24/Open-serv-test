{
  "name": "open-serv-app",
  "version": "0.1.0",
  "description": "AI-Managed DeFi Protocol for Intelligent Asset Management",
  "author": "Autonomous AI Development",
  "license": "MIT",
  "keywords": [
    "defi",
    "ai",
    "staking",
    "index-token",
    "ethereum",
    "smart-contracts",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nikhilprakash24/Open-serv-test.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "test:coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "verify": "hardhat run scripts/verify.ts",
    "clean": "hardhat clean && rm -rf cache artifacts typechain-types",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:ts": "eslint '**/*.{ts,tsx}'",
    "lint": "npm run lint:sol && npm run lint:ts",
    "format:sol": "prettier --write 'contracts/**/*.sol'",
    "format:ts": "prettier --write '**/*.{ts,tsx,json,md}'",
    "format": "npm run format:sol && npm run format:ts",
    "analyze": "slither .",
    "size": "hardhat size-contracts",
    "typechain": "hardhat typechain",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:agents": "cd agents && python -m uvicorn main:app --reload",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run compile && npm run build:backend && npm run build:frontend",
    "test:all": "npm run test && cd backend && npm test && cd ../frontend && npm test",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.3",
    "@nomicfoundation/hardhat-ethers": "^3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "chai": "^4.3.10",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "ethers": "^6.10.0",
    "hardhat": "^2.19.4",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^1.0.9",
    "husky": "^8.0.3",
    "prettier": "^3.1.1",
    "prettier-plugin-solidity": "^1.3.1",
    "solhint": "^4.1.1",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "^5.0.1"
  }
}
